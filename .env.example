# Environment variable template. Copy to `.env` and fill in real values.
# `.env` is git-ignored and must NEVER be committed.

# --- Kaggle API (alternative to ~/.kaggle/kaggle.json) ---
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- MLflow / DagsHub (used from Phase 3 onward) ---
# Leave MLFLOW_TRACKING_URI empty to record runs in the local SQLite store.
# DagsHub format: https://dagshub.com/<user>/<repo>.mlflow
# (username = DagsHub user name, password = DagsHub access token).
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
DAGSHUB_TOKEN=
